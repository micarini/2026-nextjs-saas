# Firebase Web App
# Estos valores se obtienen desde Firebase Console > Project settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Storage
# Bucket publico de la Web App. Se obtiene desde Firebase Console > Project settings > General > Your apps.
# Ejemplo de formato: nombre-del-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# false: usa imagenes locales dentro de public/items. Es la opcion predeterminada para trabajar sin facturacion.
# true: habilita upload con Cloud Storage for Firebase. Requiere crear Storage en Firebase y usar plan Blaze.
FIREBASE_STORAGE=false

# Firebase Admin SDK
# Estos valores se obtienen desde Firebase Console > Project settings > Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# NYT Books API
# Se obtiene registrando una app gratuita en developer.nytimes.com con el producto "Books API" habilitado.
# Se usa para el estante "New releases" de la home. Si falta, el estante muestra su mensaje vacio (no rompe la app).
NYT_BOOKS_API_KEY=

# Google Books API (catálogo, portadas, importador de Goodreads)
# Se obtiene en Google Cloud Console > APIs & Services > Credentials (habilitar "Books API").
# Sin key funciona, pero con una cuota compartida mucho más baja.
GOOGLE_BOOKS_API_KEY=

# Gemini (BookBot)
# Se obtiene en https://aistudio.google.com/apikey. Si falta, BookBot usa las reglas de siempre.
GEMINI_API_KEY=
# Opcional: cambia el modelo (por defecto gemini-3.6-flash).
GEMINI_MODEL=
